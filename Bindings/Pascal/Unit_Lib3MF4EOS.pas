	TLib3MF4EOSEOSContext_CreateTaskFrom3MFToolpathFunc = function(pEOSContext: TLib3MF4EOSHandle; const pModel: TLib3MFHandle; const pMachineConfiguration: TLib3MF4EOSHandle; const pSettings: TLib3MF4EOSHandle; const pName: PAnsiChar; const pComment: PAnsiChar; const pGeneratorName: PAnsiChar; const pGeneratorVersion: PAnsiChar; out pResult: TLib3MF4EOSHandle): TLib3MF4EOSResult; cdecl;
	
