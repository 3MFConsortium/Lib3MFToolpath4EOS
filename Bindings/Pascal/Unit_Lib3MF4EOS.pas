	destructor TLib3MF4EOSWrapper.Destroy;
	begin
		{$IFDEF MSWINDOWS}
			if FModule <> 0 then
				FreeLibrary(FModule);
		{$ELSE}
			if FModule <> 0 then
				UnloadLibrary(FModule);
		{$ENDIF MSWINDOWS}
		inherited;
	end;

	procedure TLib3MF4EOSWrapper.CheckError(AInstance: TLib3MF4EOSBase; AErrorCode: TLib3MF4EOSResult);
	var
		AErrorMessage: String;
	begin
		if AInstance <> nil then begin
			if AInstance.FWrapper <> Self then
				raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_INVALIDCAST, 'invalid wrapper call');
		end;
		if AErrorCode <> LIB3MF4EOS_SUCCESS then begin
			AErrorMessage := '';
			if Assigned(AInstance) then
				GetLastError(AInstance, AErrorMessage);
			raise ELib3MF4EOSException.Create(AErrorCode, AErrorMessage);
		end;
	end;

	{$IFDEF MSWINDOWS}
	function TLib3MF4EOSWrapper.LoadFunction(AFunctionName: AnsiString; FailIfNotExistent: Boolean): FARPROC;
	begin
		Result := GetProcAddress(FModule, PAnsiChar(AFunctionName));
		if FailIfNotExistent and not Assigned(Result) then
			raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_COULDNOTFINDLIBRARYEXPORT, 'could not find function ' + AFunctionName);
	end;
	{$ELSE}
	function TLib3MF4EOSWrapper.LoadFunction(AFunctionName: AnsiString; FailIfNotExistent: Boolean): Pointer;
	begin
		Result := dynlibs.GetProcAddress(FModule, AFunctionName);
		if FailIfNotExistent and not Assigned(Result) then
			raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_COULDNOTFINDLIBRARYEXPORT, 'could not find function ' + AFunctionName);
	end;
	{$ENDIF MSWINDOWS}

	procedure TLib3MF4EOSWrapper.checkBinaryVersion();
	var
		AMajor, AMinor, AMicro: Cardinal;
	begin
		GetVersion(AMajor, AMinor, AMicro);
		if (AMajor <> LIB3MF4EOS_VERSION_MAJOR) or (AMinor < LIB3MF4EOS_VERSION_MINOR) then
			raise ELib3MF4EOSException.Create(LIB3MF4EOS_ERROR_INCOMPATIBLEBINARYVERSION, '');
	end;
	
		// Imported Components
	function TLib3MF4EOSWrapper.GetLib3MFWrapper(): TLib3MFWrapper;
	begin
		if not Assigned(FLib3MFWrapper) then
			raise ELib3MF4EOSException.Create(LIB3MF4EOS_ERROR_COULDNOTLOADLIBRARY, 'Injected library Lib3MF has not yet been loaded.');
		result := FLib3MFWrapper;
	end;
		
	procedure TLib3MF4EOSWrapper.GetVersion(out AMajor: Cardinal; out AMinor: Cardinal; out AMicro: Cardinal);
	begin
		CheckError(nil, Lib3MF4EOSGetVersionFunc(AMajor, AMinor, AMicro));
	end;

	function TLib3MF4EOSWrapper.GetLastError(const AInstance: TLib3MF4EOSBase; out AErrorMessage: String): Boolean;
	var
		AInstanceHandle: TLib3MF4EOSHandle;
		bytesNeededErrorMessage: Cardinal;
		bytesWrittenErrorMessage: Cardinal;
		bufferErrorMessage: array of Char;
		ResultHasError: Byte;
	begin
		if Assigned(AInstance) then
		AInstanceHandle := AInstance.TheHandle
		else
			raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_INVALIDPARAM, 'AInstance is a nil value.');
		bytesNeededErrorMessage:= 0;
		bytesWrittenErrorMessage:= 0;
		ResultHasError := 0;
		CheckError(nil, Lib3MF4EOSGetLastErrorFunc(AInstanceHandle, 0, bytesNeededErrorMessage, nil, ResultHasError));
		SetLength(bufferErrorMessage, bytesNeededErrorMessage);
		CheckError(nil, Lib3MF4EOSGetLastErrorFunc(AInstanceHandle, bytesNeededErrorMessage, bytesWrittenErrorMessage, @bufferErrorMessage[0], ResultHasError));
		AErrorMessage := StrPas(@bufferErrorMessage[0]);
		Result := (ResultHasError <> 0);
	end;

	procedure TLib3MF4EOSWrapper.ReleaseInstance(const AInstance: TLib3MF4EOSBase);
	var
		AInstanceHandle: TLib3MF4EOSHandle;
	begin
		if Assigned(AInstance) then
		AInstanceHandle := AInstance.TheHandle
		else
			raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_INVALIDPARAM, 'AInstance is a nil value.');
		CheckError(nil, Lib3MF4EOSReleaseInstanceFunc(AInstanceHandle));
	end;

	procedure TLib3MF4EOSWrapper.AcquireInstance(const AInstance: TLib3MF4EOSBase);
	var
		AInstanceHandle: TLib3MF4EOSHandle;
	begin
		if Assigned(AInstance) then
		AInstanceHandle := AInstance.TheHandle
		else
			raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_INVALIDPARAM, 'AInstance is a nil value.');
		CheckError(nil, Lib3MF4EOSAcquireInstanceFunc(AInstanceHandle));
	end;

	procedure TLib3MF4EOSWrapper.InjectComponent(const ANameSpace: String; const ASymbolAddressMethod: Pointer);
	var
		ANameSpaceFound: boolean;
	begin
		CheckError(nil, Lib3MF4EOSInjectComponentFunc(PAnsiChar(ANameSpace), ASymbolAddressMethod));
		ANameSpaceFound := False;
		if (ANameSpace = 'Lib3MF') then begin
			if assigned(FLib3MFWrapper) then
				raise ELib3MF4EOSException.Create(LIB3MF4EOS_ERROR_COULDNOTLOADLIBRARY, 'Library with namespace ' + ANameSpace + ' is already registered.');
			FLib3MFWrapper := TLib3MFWrapper.CreateFromSymbolLookupMethod(ASymbolAddressMethod);
			ANameSpaceFound := True;
		end;
		if not ANameSpaceFound then
			raise ELib3MF4EOSException.Create(LIB3MF4EOS_ERROR_COULDNOTLOADLIBRARY, 'Unknown namespace ' + ANameSpace);
	 
	end;

	function TLib3MF4EOSWrapper.CreateContext(const ASDKDirectory: String; const ALogFileName: String): TLib3MF4EOSEOSContext;
	var
		HInstance: TLib3MF4EOSHandle;
	begin
		Result := nil;
		HInstance := nil;
		CheckError(nil, Lib3MF4EOSCreateContextFunc(PAnsiChar(ASDKDirectory), PAnsiChar(ALogFileName), HInstance));
		if Assigned(HInstance) then
			Result := TLib3MF4EOSPolymorphicFactory<TLib3MF4EOSEOSContext, TLib3MF4EOSEOSContext>.Make(Self, HInstance);
	end;


