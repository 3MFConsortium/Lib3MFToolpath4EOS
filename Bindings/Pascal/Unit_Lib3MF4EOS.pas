	constructor ELib3MF4EOSException.Create(AErrorCode: TLib3MF4EOSResult; AMessage: String);
	var
		ADescription: String;
	begin
		FErrorCode := AErrorCode;
		case FErrorCode of
			LIB3MF4EOS_ERROR_NOTIMPLEMENTED: ADescription := 'functionality not implemented';
			LIB3MF4EOS_ERROR_INVALIDPARAM: ADescription := 'an invalid parameter was passed';
			LIB3MF4EOS_ERROR_INVALIDCAST: ADescription := 'a type cast failed';
			LIB3MF4EOS_ERROR_BUFFERTOOSMALL: ADescription := 'a provided buffer is too small';
			LIB3MF4EOS_ERROR_GENERICEXCEPTION: ADescription := 'a generic exception occurred';
			LIB3MF4EOS_ERROR_COULDNOTLOADLIBRARY: ADescription := 'the library could not be loaded';
			LIB3MF4EOS_ERROR_COULDNOTFINDLIBRARYEXPORT: ADescription := 'a required exported symbol could not be found in the library';
			LIB3MF4EOS_ERROR_INCOMPATIBLEBINARYVERSION: ADescription := 'the version of the binary interface does not match the bindings interface';
			LIB3MF4EOS_ERROR_COULDNOTGETTEMPPATHFROMWINDOWS: ADescription := 'could not get temp path from windows';
			LIB3MF4EOS_ERROR_COULDNOTFINDEOSSDKDIRECTORY: ADescription := 'could not find EOS SDK Directory';
			LIB3MF4EOS_ERROR_COULDWRITELOGCONFIG: ADescription := 'could not write log config';
			LIB3MF4EOS_ERROR_EOSSDKERROR: ADescription := 'EOS SDK Error';
			LIB3MF4EOS_ERROR_DETECTEDINCOMPATIBLEEOSSDKVERSION: ADescription := 'Detected incompatible EOS SDK Version.';
			LIB3MF4EOS_ERROR_INVALIDMATERIALSETINFO: ADescription := 'Invalid material set info';
			LIB3MF4EOS_ERROR_UNKNOWNMATERIALSETMODELTYPE: ADescription := 'Unknown material set model type';
			LIB3MF4EOS_ERROR_EOSSDKHASNOTBEENLOADED: ADescription := 'EOS SDK has not been loaded';
			LIB3MF4EOS_ERROR_EOSSDKHASALDREADYBEENLOADED: ADescription := 'EOS SDK has already been loaded';
			LIB3MF4EOS_ERROR_INVALIDSTREAMDATA: ADescription := 'Invalid stream data';
			LIB3MF4EOS_ERROR_MACHINEPACKAGEFILENOTFOUND: ADescription := 'Machine package file not found.';
			LIB3MF4EOS_ERROR_MACHINEPACKAGEFILEISDIRECTORY: ADescription := 'Machine package file is directory.';
			LIB3MF4EOS_ERROR_MACHINEPACKAGEFILEISEMPTY: ADescription := 'Machine package file is empty';
			LIB3MF4EOS_ERROR_EMPTYNETWORKADDRESS: ADescription := 'Empty network address';
