 Enum conversion
**************************************************************************************************************************)

	function convertEOSTaskBlockTypeToConst(const AValue: TLib3MF4EOSEOSTaskBlockType): Integer;
	begin
		case AValue of
			eEOSTaskBlockTypeUnknown: Result := 0;
			eEOSTaskBlockTypeHatchBlock: Result := 1;
			eEOSTaskBlockTypePolylineBlock: Result := 2;
			else 
				raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_INVALIDPARAM, 'invalid enum value');
		end;
	end;
	
	function convertConstToEOSTaskBlockType(const AValue: Integer): TLib3MF4EOSEOSTaskBlockType;
	begin
		case AValue of
			0: Result := eEOSTaskBlockTypeUnknown;
			1: Result := eEOSTaskBlockTypeHatchBlock;
			2: Result := eEOSTaskBlockTypePolylineBlock;
			else 
				raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_INVALIDPARAM, 'invalid enum constant');
		end;
	end;
	
	
	function convertEOSPowerRampModeToConst(const AValue: TLib3MF4EOSEOSPowerRampMode): Integer;
	begin
		case AValue of
