	procedure TLib3MF4EOSEOSRawTaskLayer.AddData(const APoints: ArrayOfLib3MF4EOSEOSTaskPoint; const ABlocks: ArrayOfLib3MF4EOSEOSTaskBlock);
	var
		PtrPoints: PLib3MF4EOSEOSTaskPoint;
		LenPoints: QWord;
		PtrBlocks: PLib3MF4EOSEOSTaskBlock;
		LenBlocks: QWord;
	begin
		LenPoints := Length(APoints);
		if LenPoints > $FFFFFFFF then
			raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_INVALIDPARAM, 'array has too many entries.');
		if LenPoints > 0 then
			PtrPoints := @APoints[0]
		else
			PtrPoints := nil;
		
		LenBlocks := Length(ABlocks);
		if LenBlocks > $FFFFFFFF then
			raise ELib3MF4EOSException.CreateCustomMessage(LIB3MF4EOS_ERROR_INVALIDPARAM, 'array has too many entries.');
		if LenBlocks > 0 then
			PtrBlocks := @ABlocks[0]
		else
			PtrBlocks := nil;
		
		FWrapper.CheckError(Self, FWrapper.Lib3MF4EOSEOSRawTaskLayer_AddDataFunc(FHandle, QWord(LenPoints), PtrPoints, QWord(LenBlocks), PtrBlocks));
	end;

