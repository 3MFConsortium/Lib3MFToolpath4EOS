		Result := nil;
		Wrapper.CheckError(nil, Wrapper.Lib3MF4EOSBase_ClassTypeIdFunc(handle, ClassTypeId));
		case (ClassTypeId) of
			QWord($5A91C7ADA6C6F4C5): begin Obj := TLIB3MF4EOSBase.Create(Wrapper, Handle); if Obj.inheritsFrom(_T) then Result := Obj as _T; end; // First 64 bits of SHA1 of a string: "Lib3MF4EOS::Base"
			QWord($711D693C58F2E391): begin Obj := TLIB3MF4EOSEOSSDKSimulator.Create(Wrapper, Handle); if Obj.inheritsFrom(_T) then Result := Obj as _T; end; // First 64 bits of SHA1 of a string: "Lib3MF4EOS::EOSSDKSimulator"
